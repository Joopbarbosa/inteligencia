{
  "name": "leitor-fiscal",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db/migracoes && cp src/db/migracoes/*.sql dist/db/migracoes/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "chave:criar": "node dist/autenticacao/cli.js criar",
    "chave:revogar": "node dist/autenticacao/cli.js revogar"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
