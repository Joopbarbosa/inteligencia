# whisper: só nomes e valores padrão, nunca segredo real. Copiar para .env (ignorado pelo git).
WHISPER_IMAGEM=ghcr.io/speaches-ai/speaches:0.8.3-cpu
# Chave de acesso à API (gerar um valor aleatório longo)
WHISPER_API_CHAVE=
# Quanto tempo o modelo fica na memória sem uso (segundos)
WHISPER_MODELO_TTL=300
WHISPER_THREADS=4
WHISPER_MEMORIA=2g
