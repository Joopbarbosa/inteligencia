# Copiar para .env e preencher. Nunca commitar .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# IA: primeiro da cadeia e fallback (TIPO_ADAPTADOR: openai-compativel ou anthropic)
IA_PROVEDOR_PRIMARIO_TIPO_ADAPTADOR=
IA_PROVEDOR_PRIMARIO_URL_BASE=
IA_PROVEDOR_PRIMARIO_CHAVE=
IA_PROVEDOR_PRIMARIO_MODELO=
IA_PROVEDOR_FALLBACK_TIPO_ADAPTADOR=
IA_PROVEDOR_FALLBACK_URL_BASE=
IA_PROVEDOR_FALLBACK_CHAVE=
IA_PROVEDOR_FALLBACK_MODELO=

# Limites e retenção (valores iniciais definidos no plano de execução)
LIMITE_IA_MENSAL_POR_CONTA=30
LIMITE_IA_MENSAL_POR_CHAVE=2000
RETENCAO_AMOSTRAS_MESES=12

# HTTP interno; produção mantém a porta sem publicação no host
API_PORT=3000
IA_HABILITADA=0

# Só ligar depois do teste de QR real e consulta da VPS contra o portal SP
SP_LEITOR_LIBERADO=false

# Preços opcionais por milhão de tokens; ausentes = custo estimado desconhecido (null)
IA_PROVEDOR_PRIMARIO_PRECO_ENTRADA_USD_MILHAO=
IA_PROVEDOR_PRIMARIO_PRECO_SAIDA_USD_MILHAO=
IA_PROVEDOR_FALLBACK_PRECO_ENTRADA_USD_MILHAO=
IA_PROVEDOR_FALLBACK_PRECO_SAIDA_USD_MILHAO=

# Envio opcional de alertas "Mapear leitor da UF" (um só conjunto de variáveis); IDs confirmados no OpenProject configurado.
# Sem URL e chave o serviço grava os alertas localmente e não envia nada. Projeto padrão: 9 (inteligencia).
OPENPROJECT_URL=
OPENPROJECT_API_KEY=
OPENPROJECT_TIPO_TAREFA_ID=
OPENPROJECT_PRIORIDADE_NORMAL_ID=
OPENPROJECT_PROJETO_ID=9
