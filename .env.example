# evolution: só nomes; valores reais ficam no .env (ignorado pelo git).
EVOLUTION_DB_USUARIO=
EVOLUTION_DB_SENHA=
# Versão fixada: nunca "latest". A 2.3.7 é a estável sem ativação de licença.
EVOLUTION_API_IMAGEM=evoapicloud/evolution-api:v2.3.7
EVOLUTION_API_URL_INTERNA=http://evolution-api:8080
# Chave GLOBAL: só para administrar o serviço. Nenhum produto usa a chave global; cada produto usa a chave da sua instância.
EVOLUTION_API_CHAVE_GLOBAL=
