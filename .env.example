# OpenProject Configuration
# Copy this file to .env and fill in your values (.env nunca é commitado — ver .gitignore)

# Required: URL da instância do OpenProject
# Instância self-hosted local: Infraestrutura/OpenProject/ (docker, porta 8090)
OPENPROJECT_URL=http://localhost:8090

# Required: Token de API do OpenProject
# Gerar em: User Menu (canto superior direito) -> Account Settings -> Access tokens -> "+ Api Token"
OPENPROJECT_API_KEY=your-api-key-here

# Optional: HTTP proxy (deixar vazio para conexão direta)
OPENPROJECT_PROXY=

# Optional: nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
