# Copiar para .env e preencher. Nunca commitar .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# IA: primeiro da cadeia e fallback (TIPO_ADAPTADOR: openai-compativel ou anthropic)
IA_PROVEDOR_PRIMARIO_TIPO_ADAPTADOR=
IA_PROVEDOR_PRIMARIO_URL_BASE=
IA_PROVEDOR_PRIMARIO_CHAVE=
IA_PROVEDOR_PRIMARIO_MODELO=
IA_PROVEDOR_FALLBACK_TIPO_ADAPTADOR=
IA_PROVEDOR_FALLBACK_URL_BASE=
IA_PROVEDOR_FALLBACK_CHAVE=
IA_PROVEDOR_FALLBACK_MODELO=

# Alertas no OpenProject
OP_URL=
OP_TOKEN=
OP_PROJETO_ID=9

# Limites e retenção (valores iniciais definidos no plano de execução)
LIMITE_IA_MENSAL_POR_CONTA=
LIMITE_IA_MENSAL_POR_CHAVE=
RETENCAO_AMOSTRAS_MESES=12

# HTTP interno; produção mantém a porta sem publicação no host
API_PORT=3000
IA_HABILITADA=0
